<%- include('./header.ejs') %>
<main role="main" class="container">
	<div class="row text-center">
		<h1 class="display-5 fw-bold">Secret Santa 2026 Questionaire</h1>
		<p class="lead mb-4">
			<span style="color: green;">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
					<path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
				</svg>
			</span>
			<%= s.complete_success %>
		</p>
	</div>
	<div class="row">
		<div class="col-md-6 text-center">
			<a href="" class="btn btn-secondary hfill"><%= s.submit_again %></a>
		</div>
		<div class="col-md-6 text-center">
			<a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ?autoplay=1" class="btn btn-primary hfill"><%= s.finish %></a>
		</div>
	</div>
</main><!-- /.container -->
<%- include('./footer.ejs') %>
